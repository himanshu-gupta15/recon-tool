{
  "name": "recon-tool",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n db,api,web -c gray,blue,green \"npm run db -w server\" \"npm run dev -w server\" \"npm run dev -w web\"",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "perf": "npm run perf -w server",
    "build": "npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
